output_path <- "C:/Users/Matt/Documents/data/alcohol_crashes_monthly.png"
# ------------------------------------------------------------
# EL PASO CRIME LAB COLOR PALETTE
# ------------------------------------------------------------
ecl_colors <- c(
"2025" = "#6B7280",   # muted gray
"2026" = "#38BDF8"    # bright blue
)
# Dark background colors
bg_dark <- "#6f281b"
panel_dark <- "#6f281b"
text_light <- "#F3F4F6"
text_muted <- "#9CA3AF"
grid_dark <- "#374151"
# ------------------------------------------------------------
# LOAD DATA
# ------------------------------------------------------------
data <- read.csv(
data_path,
header = TRUE
)
# ------------------------------------------------------------
# CLEAN DATA
# ------------------------------------------------------------
data$City <- recode(
data$City,
"EL PASO" = "El Paso"
)
data <- data %>%
mutate(
Crash.Date = mdy(Crash.Date)
) %>%
# Remove the current incomplete month
filter(
!(
year(Crash.Date) == year(Sys.Date()) &
month(Crash.Date) == month(Sys.Date())
)
)
