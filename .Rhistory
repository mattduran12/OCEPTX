################################################################################
# RP ANALYZER
# 2024 ACS 5-YEAR ESTIMATES
#
# TEXAS COUNTIES + CENSUS PLACES
#
# Population age 18+ by race/ethnicity
#
# Source:
# U.S. Census Bureau
# 2024 American Community Survey 5-Year Estimates
#
# Tables:
# C01001A-I = Sex by Age by Race/Ethnicity
# B03002    = Hispanic or Latino Origin by Race
#
# IMPORTANT:
#
# The ACS does not contain the exact same mutually exclusive 18+ race/
# ethnicity table used by the 2020 Decennial Census P4 table.
#
# Therefore:
#
# 1. Total adult population is calculated from C01001.
#
# 2. Hispanic/Latino adult population is calculated from C01001I.
#
# 3. Non-Hispanic White adult population is calculated directly from
#    C01001H.
#
# 4. Adult Black, AIAN, Asian, and NHPI populations are calculated from
#    the corresponding C01001 race tables and adjusted using the
#    non-Hispanic share of that race from B03002.
#
# This produces a current ACS-based adult population benchmark for use
# in the RP Analyzer.
################################################################################
################################################################################
# 1. PACKAGES
################################################################################
packages <- c(
"httr2",
"jsonlite",
"dplyr",
"readr"
)
for (p in packages) {
if (!requireNamespace(p, quietly = TRUE)) {
install.packages(p)
}
}
library(httr2)
library(jsonlite)
library(dplyr)
library(readr)
################################################################################
# 2. SETTINGS
################################################################################
# Latest complete ACS 5-Year dataset currently available
CENSUS_YEAR <- 2024
STATE <- "48"
API_KEY <- "6bd53b7acd8614393fce1efb2470d0ce2684b2b6"
################################################################################
# 3. OUTPUT
################################################################################
DATA_DIR <- file.path(
getwd(),
"data"
)
if (!dir.exists(DATA_DIR)) {
dir.create(
DATA_DIR,
recursive = TRUE
)
}
OUTPUT_FILE <- file.path(
DATA_DIR,
"texas_census_2024_acs5_age18_race_ethnicity.csv"
)
################################################################################
# 4. ACS VARIABLES
################################################################################
#
# C01001 = Sex by Age
#
# C01001A = White Alone
# C01001B = Black or African American Alone
# C01001C = American Indian and Alaska Native Alone
# C01001D = Asian Alone
# C01001E = Native Hawaiian and Other Pacific Islander Alone
# C01001F = Some Other Race Alone
# C01001G = Two or More Races
# C01001H = White Alone, Not Hispanic or Latino
# C01001I = Hispanic or Latino
#
#
# Each C01001 race table has:
#
# Male:
#   Under 18
#   18 to 64
#   65 years and over
#
# Female:
#   Under 18
#   18 to 64
#   65 years and over
#
#
# Therefore:
#
# Adult population =
#
# Male 18-64
# + Male 65+
# + Female 18-64
# + Female 65+
#
################################################################################
################################################################################
# 4A. AGE VARIABLES
################################################################################
age_variables <- c(
"NAME",
# --------------------------------------------------------------------------
# Total population
# --------------------------------------------------------------------------
"C01001_003E",
"C01001_004E",
"C01001_006E",
"C01001_007E",
# --------------------------------------------------------------------------
# White alone
# --------------------------------------------------------------------------
"C01001A_003E",
"C01001A_004E",
"C01001A_006E",
"C01001A_007E",
# --------------------------------------------------------------------------
# Black alone
# --------------------------------------------------------------------------
"C01001B_003E",
"C01001B_004E",
"C01001B_006E",
"C01001B_007E",
# --------------------------------------------------------------------------
# American Indian / Alaska Native alone
# --------------------------------------------------------------------------
"C01001C_003E",
"C01001C_004E",
"C01001C_006E",
"C01001C_007E",
# --------------------------------------------------------------------------
# Asian alone
# --------------------------------------------------------------------------
"C01001D_003E",
"C01001D_004E",
"C01001D_006E",
"C01001D_007E",
# --------------------------------------------------------------------------
# Native Hawaiian / Pacific Islander alone
# --------------------------------------------------------------------------
"C01001E_003E",
"C01001E_004E",
"C01001E_006E",
"C01001E_007E",
# --------------------------------------------------------------------------
# White alone, not Hispanic or Latino
# --------------------------------------------------------------------------
"C01001H_003E",
"C01001H_004E",
"C01001H_006E",
"C01001H_007E",
# --------------------------------------------------------------------------
# Hispanic or Latino
# --------------------------------------------------------------------------
"C01001I_003E",
"C01001I_004E",
"C01001I_006E",
"C01001I_007E"
)
################################################################################
# 4B. HISPANIC / RACE VARIABLES
################################################################################
#
# B03002 is:
#
# Hispanic or Latino Origin by Race
#
# These variables allow the adult race totals from C01001 to be adjusted
# to the non-Hispanic population for the race-specific categories.
#
################################################################################
race_variables <- c(
"B03002_001E",
# Not Hispanic
"B03002_002E",
# Not Hispanic White
"B03002_003E",
# Not Hispanic Black
"B03002_004E",
# Not Hispanic AIAN
"B03002_005E",
# Not Hispanic Asian
"B03002_006E",
# Not Hispanic NHPI
"B03002_007E",
# Not Hispanic Other Race
"B03002_008E",
# Not Hispanic Two or More Races
"B03002_009E",
# Hispanic
"B03002_012E",
# Hispanic White
"B03002_013E",
# Hispanic Black
"B03002_014E",
# Hispanic AIAN
"B03002_015E",
# Hispanic Asian
"B03002_016E",
# Hispanic NHPI
"B03002_017E"
)
################################################################################
# 4C. COMBINE VARIABLES
################################################################################
variables <- c(
age_variables,
race_variables[-1]
)
################################################################################
# 5. FUNCTION TO DOWNLOAD CENSUS DATA
################################################################################
download_census <- function(
geography
) {
base_url <- paste0(
"https://api.census.gov/data/",
CENSUS_YEAR,
"/acs/acs5"
)
# --------------------------------------------------------------------------
# Build URL manually.
#
# This follows the same structure as the successful 2020 Decennial
# Census script.
# --------------------------------------------------------------------------
url <- paste0(
base_url,
"?get=",
paste(
variables,
collapse = ","
),
"&for=",
geography,
":*",
"&in=state:",
STATE,
"&key=",
API_KEY
)
cat("\n")
cat("============================================================\n")
cat("Downloading:", geography, "\n")
cat("============================================================\n")
response <- request(url) |>
req_user_agent(
"RP Analyzer - Census Benchmark Application"
) |>
req_perform()
status <- resp_status(response)
cat(
"HTTP status:",
status,
"\n"
)
# --------------------------------------------------------------------------
# Get response as text
# --------------------------------------------------------------------------
response_text <- resp_body_string(
response
)
# --------------------------------------------------------------------------
# STOP if Census returned an error
# --------------------------------------------------------------------------
if (status != 200) {
cat("\nCensus response:\n")
cat(response_text)
stop(
paste0(
"\n\nCensus API returned HTTP ",
status,
"."
),
call. = FALSE
)
}
# --------------------------------------------------------------------------
# Make sure response is actually JSON
# --------------------------------------------------------------------------
if (
grepl(
"^\\s*<",
response_text
)
) {
cat(
"\nThe Census server returned HTML instead of JSON.\n\n"
)
cat(
"Beginning of response:\n\n"
)
cat(
substr(
response_text,
1,
1000
)
)
stop(
"\n\nCensus returned HTML instead of JSON.",
call. = FALSE
)
}
# --------------------------------------------------------------------------
# Convert JSON to data frame
# --------------------------------------------------------------------------
result <- fromJSON(
response_text,
simplifyDataFrame = TRUE
)
result <- as.data.frame(
result,
stringsAsFactors = FALSE
)
# --------------------------------------------------------------------------
# First row contains column names
# --------------------------------------------------------------------------
names(result) <- as.character(
result[1, ]
)
result <- result[-1, , drop = FALSE]
rownames(result) <- NULL
# --------------------------------------------------------------------------
# Check that NAME exists
# --------------------------------------------------------------------------
if (!"NAME" %in% names(result)) {
stop(
paste0(
"\nNAME was not returned by the Census API.\n\n",
"Columns returned:\n",
paste(
names(result),
collapse = ", "
)
),
call. = FALSE
)
}
return(result)
}
################################################################################
# 6. DOWNLOAD COUNTIES
################################################################################
county_data <- download_census(
geography = "county"
)
