!(
year(Crash.Date) == year(Sys.Date()) &
month(Crash.Date) == month(Sys.Date())
)
)
# ------------------------------------------------------------
# CRASH-LEVEL DATA
# ------------------------------------------------------------
crash_level <- data %>%
distinct(
Crash.ID,
.keep_all = TRUE
)
# ------------------------------------------------------------
# REPORTING MONTH
# Data lag = approximately one month
# ------------------------------------------------------------
report_date <- Sys.Date() %m-% months(1)
report_year <- year(report_date)
prev_year <- report_year - 1
# ------------------------------------------------------------
# MONTHLY CRASH DATA
# ------------------------------------------------------------
build_monthly <- function(df, value) {
df %>%
mutate(
year = year(Crash.Date),
month = month(Crash.Date)
) %>%
filter(
year %in% c(report_year, prev_year)
) %>%
group_by(year, month) %>%
summarise(
val = {{ value }},
.groups = "drop"
) %>%
complete(
year,
month = 1:12,
fill = list(val = 0)
) %>%
mutate(
month_lab = factor(
month.abb[month],
levels = month.abb
),
year = factor(year)
)
}
# ------------------------------------------------------------
# CRASH COUNTS
# ------------------------------------------------------------
crash_plot_data <- build_monthly(
crash_level %>%
filter(City == "El Paso"),
n_distinct(Crash.ID)
)
# ------------------------------------------------------------
# REMOVE FUTURE MONTHS FOR CURRENT YEAR
# ------------------------------------------------------------
crash_plot_data <- crash_plot_data %>%
filter(
!(
as.numeric(as.character(year)) == report_year &
month > month(report_date)
)
)
# ------------------------------------------------------------
# CREATE LABELS
# ------------------------------------------------------------
crash_plot_data <- crash_plot_data %>%
mutate(
year_label = as.character(year),
month_full = month.name[match(month_lab, month.abb)]
)
# ------------------------------------------------------------
# PLOT
# ------------------------------------------------------------
p <- ggplot(
crash_plot_data,
aes(
x = month_lab,
y = val,
fill = year
)
) +
# Bars
geom_col(
position = position_dodge(width = 0.82),
width = 0.72
) +
# Values above bars
geom_text(
aes(
label = comma(val),
y = val + max(val, na.rm = TRUE) * 0.025
),
position = position_dodge(width = 0.82),
color = text_light,
size = 3.2,
fontface = "bold",
vjust = 0
) +
# El Paso Crime Lab colors
scale_fill_manual(
values = ecl_colors
) +
# Y-axis
scale_y_continuous(
labels = comma,
expand = expansion(
mult = c(0, 0.12)
)
) +
# Labels
labs(
title = "Alcohol-Related Crashes in El Paso",
subtitle = paste0(
"Monthly comparison: ",
prev_year,
" vs. ",
report_year
),
x = NULL,
y = "Total crashes",
fill = NULL,
caption = paste0(
"Source: Texas Department of Transportation  |  ",
"El Paso Crime Lab"
)
) +
# ----------------------------------------------------------
# DARK THEME
# ----------------------------------------------------------
theme_minimal(
base_size = 12
) +
theme(
# Background
plot.background = element_rect(
fill = bg_dark,
color = NA
),
panel.background = element_rect(
fill = panel_dark,
color = NA
),
# Title
plot.title = element_text(
color = text_light,
size = 22,
face = "bold",
hjust = 0
),
# Subtitle
plot.subtitle = element_text(
color = text_muted,
size = 12,
hjust = 0,
margin = margin(
b = 18
)
),
# X-axis
axis.text.x = element_text(
color = text_light,
size = 10,
face = "bold"
),
# Y-axis
axis.text.y = element_text(
color = text_muted,
size = 9
),
axis.title.y = element_text(
color = text_muted,
size = 10
),
# Grid
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_line(
color = grid_dark,
linewidth = 0.35
),
# Legend
legend.position = "bottom",
legend.text = element_text(
color = text_light,
size = 10
),
legend.key = element_rect(
fill = bg_dark,
color = NA
),
# Caption
plot.caption = element_text(
color = text_muted,
size = 8.5,
hjust = 0,
margin = margin(
t = 12
)
),
# Plot margins
plot.margin = margin(
20, 25, 15, 25
)
)
# ------------------------------------------------------------
# DISPLAY PLOT
# ------------------------------------------------------------
print(p)
# ------------------------------------------------------------
# EXPORT PNG
# ------------------------------------------------------------
ggsave(
filename = output_path,
plot = p,
width = 12,
height = 7,
units = "in",
dpi = 300,
bg = bg_dark
)
message(
"Plot saved to: ",
output_path
)
