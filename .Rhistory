)
)
div(
class = "report-card",
div(class = "report-title", "Comparative Analysis of Motor Vehicle Stops"),
div(class = "report-subtitle", agency_label, " — ", dat$year, area_text),
h4("Purpose"),
p(
"This analysis summarizes motor vehicle stops reported by ", agency_label,
" during the ", dat$year, " reporting period. The analysis describes the racial and ",
"ethnic distribution of reported traffic stops and identifies the selected Texas jurisdiction used as the population benchmark."
),
h4("Methods"),
p(
"The percentage of traffic stops for each racial or ethnic category was calculated by dividing the number of stops in ",
"that category by the total number of reported stops."
),
p(
"The selected jurisdiction is ", tags$strong(dat$jurisdiction),
". The total adult (18+) population of the jurisdiction is ",
tags$strong(comma(dat$population_total)),
" according to 2020 Census data from ", tags$strong("texas_census_2020_age18_race_ethnicity.csv"), "."
),
h4("Results"),
p("The agency reported ", tags$strong(comma(dat$total_stops)), " motor vehicle stops during the reporting period."),
stop_table,
h4(paste0("Selected Jurisdiction — ", dat$jurisdiction)),
tags$table(
class = "data-table",
tags$thead(
tags$tr(
tags$th("Measure"),
tags$th("Value")
)
),
tags$tbody(
tags$tr(tags$td("Geography Type"), tags$td(dat$geography_type)),
tags$tr(tags$td("Census Geography ID"), tags$td(dat$jurisdiction_id)),
tags$tr(tags$td("Total Adult Population (18+)"), tags$td(comma(dat$population_total)))
)
),
div(class = "footnote", "Source: texas_census_2020_age18_race_ethnicity.csv."),
h4("Conclusion"),
p(
"The analysis provides a descriptive summary of traffic-stop activity by race or ethnicity against local 2020 Census 18+ demographic benchmarks."
),
p("Differences in traffic-stop counts should not be treated as standalone evidence of racial profiling or discriminatory policing."),
div(
class = "status-note status-warning",
tags$strong("Important: "),
"This generated analysis is a preliminary draft. The reporting agency should verify all values, data definitions, reporting-area assumptions, and applicable Texas reporting requirements before using the document for official submission."
)
)
})
# ==========================================================
# PDF DOWNLOAD
# ==========================================================
output$download_report <- downloadHandler(
filename = function() {
agency <- trimws(input$report_agency)
agency <- ifelse(agency == "", "Traffic_Stop_Comparative_Analysis", paste0(gsub("[^A-Za-z0-9]+", "_", agency), "_Comparative_Analysis"))
paste0(agency, "_", input$report_year, ".pdf")
},
content = function(file) {
dat <- report_data()
if (is.null(dat)) stop("Generate the comparative analysis before downloading the PDF.")
temp_dir <- tempfile("rp_report_")
dir.create(temp_dir, recursive = TRUE)
rmd_file <- file.path(temp_dir, "comparative_report.Rmd")
stop_rows <- paste0(
"| ", race_cols,
" | ", format(dat$stop_counts, big.mark = ","),
" | ", sprintf("%.1f", dat$stop_percent), "%",
" | ", format(dat$pop_counts, big.mark = ","),
" | ", sprintf("%.2f", dat$stop_per_1000), " |\n",
collapse = ""
)
agency_label <- ifelse(dat$agency == "", "Law Enforcement Agency", dat$agency)
area_text <- ifelse(dat$area == "", "", paste0(" — ", dat$area))
rmd_text <- paste0(
"---\n",
"title: \"Comparative Analysis of Motor Vehicle Stops\"\n",
"author: \"El Paso Crime Lab\"\n",
"date: \"", format(Sys.Date(), "%B %d, %Y"), "\"\n",
"output:\n",
"  pdf_document:\n",
"    toc: false\n",
"geometry: margin=1in\n",
"---\n\n",
"# Comparative Analysis of Motor Vehicle Stops\n\n",
"**Agency:** ", agency_label, "\\\n",
"**Reporting Year:** ", dat$year, area_text, "\\\n",
"**Population Benchmark:** ", dat$jurisdiction, "\\\n",
"**Geography Type:** ", dat$geography_type, "\\\n",
"**Census Geography ID:** ", dat$jurisdiction_id, "\n\n",
"## Purpose\n\n",
"This analysis summarizes motor vehicle stops reported by ", agency_label,
" during the ", dat$year, " reporting period. The analysis describes the racial and ethnic distribution of reported traffic stops and identifies the selected Texas jurisdiction used as the population benchmark.\n\n",
"## Methods\n\n",
"The percentage of traffic stops for each racial or ethnic category was calculated by dividing the number of stops in that category by the total number of reported stops.\n\n",
"The selected jurisdiction is ", dat$jurisdiction, ". Its total adult (18+) population is ", format(dat$population_total, big.mark = ","),
" according to 2020 Census data from texas_census_2020_age18_race_ethnicity.csv.\n\n",
"## Results\n\n",
"The agency reported **", format(dat$total_stops, big.mark = ","), "** motor vehicle stops during the reporting period.\n\n",
"| Race / Ethnicity | Number of Stops | Percentage of Stops | Census 18+ Pop | Stops / 1k Group Pop |\n",
"|:--|--:|--:|--:|--:|\n",
stop_rows, "\n\n",
"## Conclusion\n\n",
"The analysis provides a descriptive summary of traffic-stop activity by race or ethnicity relative to local 2020 Census 18+ adult benchmarks.\n\n",
"Differences in traffic-stop counts should not be treated as standalone evidence of racial profiling or discriminatory policing.\n\n",
"---\n\n",
"**Source:** texas_census_2020_age18_race_ethnicity.csv.\n\n",
"**Important:** This generated analysis is a preliminary draft. The reporting agency should verify all values, data definitions, reporting-area assumptions, and applicable Texas reporting requirements before using the document for official submission."
)
writeLines(rmd_text, rmd_file)
oldwd <- getwd()
on.exit(setwd(oldwd), add = TRUE)
setwd(temp_dir)
rmarkdown::render(input = rmd_file, output_file = basename(file), output_dir = dirname(file), quiet = TRUE)
generated_file <- file.path(dirname(file), paste0(tools::file_path_sans_ext(basename(file)), ".pdf"))
if (file.exists(generated_file)) {
file.copy(generated_file, file, overwrite = TRUE)
} else {
stop("The PDF could not be generated.")
}
}
)
}
